[Unit]
Description=amiibo-pi Bluetooth transport
After=dbus.service
# Recovery may restart bluetooth.service while this unit is stopping.
Wants=bluetooth.service
StartLimitIntervalSec=120
StartLimitBurst=4

[Service]
Type=notify
User=root
Group=amiibo-pi
EnvironmentFile=/etc/amiibo-pi/bluetooth.env
ExecStart=/usr/local/libexec/amiibo-pi/amiibo-bt serve
ExecStopPost=/usr/local/libexec/amiibo-pi/amiibo-bt recover
RuntimeDirectory=amiibo-bt
RuntimeDirectoryMode=0750
StateDirectory=amiibo-bt
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=3
TimeoutStopSec=65
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
RestrictAddressFamilies=AF_UNIX AF_BLUETOOTH AF_NETLINK AF_INET
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_DAC_OVERRIDE CAP_CHOWN CAP_FOWNER
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100

[Install]
WantedBy=multi-user.target
